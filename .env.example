# Plantilla de variables de entorno de DentFinance.
# Local y VPS: copia este archivo a .env (deploy/instalar_vps.sh lo crea solo).

# --- Django ---
DJANGO_SECRET_KEY=          # obligatoria en el VPS (vacía = modo desarrollo local)
DJANGO_DEBUG=0              # 1 solo en local
DJANGO_ALLOWED_HOSTS=       # ej. midominio.com,www.midominio.com,IP_DEL_VPS
DJANGO_HTTPS=1              # 0 solo mientras no tengas certificado SSL (probando por IP)

# --- Base de datos MySQL (vacío = SQLite local) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Comprobantes ---
DJANGO_MEDIA_ROOT=          # opcional; por defecto ./media

# --- Solo para migrar los datos antiguos (exportar_appwrite) ---
APPWRITE_ENDPOINT=          # ej. https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=           # permisos: databases.read, collections.read, documents.read, files.read, users.read
APPWRITE_DATABASE_ID=
APPWRITE_BUCKET_ID=
