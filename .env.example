# Plantilla de variables de entorno de DentFinance.
# Local: copia este archivo a .env. Render: crea estas claves en Environment.

# --- Django ---
DJANGO_SECRET_KEY=          # obligatoria en producción (clave larga y aleatoria)
DJANGO_DEBUG=0              # 1 solo en local
DJANGO_ALLOWED_HOSTS=       # opcional; Render agrega su dominio automáticamente

# --- Base de datos ---
DATABASE_URL=               # postgresql://usuario:clave@host/db?sslmode=require (vacío = SQLite local)

# --- Appwrite Storage (comprobantes) ---
APPWRITE_ENDPOINT=          # ej. https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_ID=
APPWRITE_API_KEY=           # API key con permisos files.read y files.write

# --- Keep-alive ---
KEEPALIVE_ENABLED=1         # en Render ya viene activo por defecto
KEEPALIVE_INTERVAL=600      # segundos entre latidos
