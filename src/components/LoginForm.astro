<form class="login-form" id="loginForm" novalidate>
  <div class="form-group">
    <label for="login-email" class="form-label">Correo Electrónico</label>
    <input type="email" id="login-email" name="email" class="form-input" placeholder="admin@dental.com" />
    <p class="error-message" id="login-email-error" />
  </div>

  <div class="form-group">
    <label for="login-password" class="form-label">Contraseña</label>
    <input type="password" id="login-password" name="password" class="form-input" placeholder="••••••••" />
    <p class="error-message" id="login-password-error" />
  </div>

  <div class="form-options">
    <label class="checkbox-container">
      <input type="checkbox" name="rememberMe" class="checkbox-input" id="loginRemember" />
      <span class="checkbox-custom" />
      <span class="checkbox-label">Recordarme</span>
    </label>
    <a href="#" class="forgot-password" id="forgotLink">¿Olvidaste tu contraseña?</a>
  </div>

  <button type="submit" class="btn-primary w-full" id="login-submit">
    Iniciar Sesión
  </button>

  <p class="auth-hint" id="loginHint">
    Inicia sesión con tu cuenta registrada
  </p>
</form>

<!-- Recovery Modal -->
<div class="recovery-overlay hidden" id="recoveryOverlay">
  <div class="recovery-modal">
    <div class="recovery-header">
      <h3>Recuperar Contraseña</h3>
      <button class="recovery-close" id="recoveryClose">&times;</button>
    </div>
    <div class="recovery-body">
      <p class="recovery-desc">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
      <div class="form-group">
        <input type="email" id="recoveryEmail" class="form-input" placeholder="tu@correo.com" />
        <p class="error-message" id="recoveryError" />
      </div>
      <div class="recovery-success hidden" id="recoverySuccess">
        <span>&#10003;</span> Correo enviado. Revisa tu bandeja de entrada.
      </div>
    </div>
    <div class="recovery-footer">
      <button class="recovery-btn-cancel" id="recoveryCancel">Cancelar</button>
      <button class="btn-primary" id="recoverySubmit">Enviar Enlace</button>
    </div>
  </div>
</div>

<script>
  import { account } from '../lib/appwrite';

  const form = document.getElementById('loginForm');
  const emailInput = document.getElementById('login-email');
  const passwordInput = document.getElementById('login-password');
  const emailError = document.getElementById('login-email-error');
  const passwordError = document.getElementById('login-password-error');
  const submitBtn = document.getElementById('login-submit');
  const rememberChk = document.getElementById('loginRemember');

  // Remember Me: restore saved email
  const savedEmail = localStorage.getItem('df_remembered_email');
  if (savedEmail) {
    emailInput.value = savedEmail;
    rememberChk.checked = true;
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function clearError(input) {
    input.classList.remove('error');
    if (input === emailInput) emailError.textContent = '';
    if (input === passwordInput) passwordError.textContent = '';
  }

  emailInput.addEventListener('input', () => clearError(emailInput));
  passwordInput.addEventListener('input', () => clearError(passwordInput));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let valid = true;

    if (!emailInput.value) {
      emailInput.classList.add('error');
      emailError.textContent = 'El correo electrónico es requerido';
      valid = false;
    } else if (!validateEmail(emailInput.value)) {
      emailInput.classList.add('error');
      emailError.textContent = 'Por favor ingresa un correo electrónico válido';
      valid = false;
    }

    if (!passwordInput.value) {
      passwordInput.classList.add('error');
      passwordError.textContent = 'La contraseña es requerida';
      valid = false;
    }

    if (!valid) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="loading-spinner"></span> Cargando...';

    try {
      try { await account.deleteSession('current'); } catch (_) {}
      await account.createEmailPasswordSession(emailInput.value, passwordInput.value);
      const user = await account.get();
      localStorage.setItem('df_logged', 'true');
      localStorage.setItem('df_name', user.name);
      localStorage.setItem('df_email', user.email);

      if (rememberChk.checked) {
        localStorage.setItem('df_remembered_email', emailInput.value);
      } else {
        localStorage.removeItem('df_remembered_email');
      }

      window.location.href = '/dashboard';
    } catch (err) {
      emailInput.classList.add('error');
      passwordInput.classList.add('error');
      emailError.textContent = 'Credenciales incorrectas';
      passwordError.textContent = err.message || 'Error al iniciar sesión';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Iniciar Sesión';
    }
  });

  // Forgot Password
  const forgotLink = document.getElementById('forgotLink');
  const recoveryOverlay = document.getElementById('recoveryOverlay');
  const recoveryClose = document.getElementById('recoveryClose');
  const recoveryCancel = document.getElementById('recoveryCancel');
  const recoverySubmit = document.getElementById('recoverySubmit');
  const recoveryEmail = document.getElementById('recoveryEmail');
  const recoveryError = document.getElementById('recoveryError');
  const recoverySuccess = document.getElementById('recoverySuccess');

  function openRecovery() {
    recoveryOverlay.classList.remove('hidden');
    recoveryEmail.value = emailInput.value || '';
    recoveryError.textContent = '';
    recoverySuccess.classList.add('hidden');
    recoverySubmit.disabled = false;
    recoverySubmit.textContent = 'Enviar Enlace';
  }

  function closeRecovery() {
    recoveryOverlay.classList.add('hidden');
  }

  forgotLink.addEventListener('click', (e) => {
    e.preventDefault();
    openRecovery();
  });
  recoveryClose.addEventListener('click', closeRecovery);
  recoveryCancel.addEventListener('click', closeRecovery);
  recoveryOverlay.addEventListener('click', (e) => {
    if (e.target === recoveryOverlay) closeRecovery();
  });

  recoverySubmit.addEventListener('click', async () => {
    const email = recoveryEmail.value.trim();
    if (!email || !validateEmail(email)) {
      recoveryError.textContent = 'Ingresa un correo válido';
      return;
    }
    recoveryError.textContent = '';
    recoverySubmit.disabled = true;
    recoverySubmit.innerHTML = '<span class="loading-spinner"></span> Enviando...';

    try {
      const url = window.location.origin + '/recovery';
      await account.createRecovery(email, url);
      recoverySuccess.classList.remove('hidden');
      recoverySubmit.textContent = 'Enviado';
      setTimeout(closeRecovery, 3000);
    } catch (err) {
      recoveryError.textContent = err.message || 'Error al enviar el correo';
      recoverySubmit.disabled = false;
      recoverySubmit.textContent = 'Enviar Enlace';
    }
  });
</script>

<style>
