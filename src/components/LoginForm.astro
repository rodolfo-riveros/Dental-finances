  .form-group { display: flex; flex-direction: column; gap: 0.3rem; }
  .form-label { font-size: 0.8rem; font-weight: 600; color: var(--c-text); }
  .form-input {
    padding: 0.65rem 0.85rem;
    border: 1.5px solid var(--c-glass-border);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.6);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--c-text);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    outline: none;
  }
  .form-input:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px var(--c-primary-glow);
    transform: scale(1.02);
  }
  .form-input.error { border-color: var(--c-danger); }
  .form-input.error:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.15); }
  .form-input::placeholder { color: #94A3B8; }

  .error-message {
    font-size: 0.75rem;
    color: var(--c-danger);
    min-height: 1em;
    animation: slideDown 0.2s ease-out;
  }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .checkbox-container:active { transform: scale(0.98); }
  .checkbox-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .checkbox-custom {
    width: 16px; height: 16px;
    border: 1.5px solid #CBD5E1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s;
  }
  .checkbox-input:checked + .checkbox-custom {
    background: var(--c-primary);
    border-color: var(--c-primary);
  }
  .checkbox-input:checked + .checkbox-custom::after {
    content: '';
    width: 4px; height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-top: -2px;
  }
  .checkbox-label { font-size: 0.8rem; color: var(--c-text); user-select: none; }
  .checkbox-container:hover .checkbox-custom { border-color: var(--c-primary); }

  .forgot-password {
    font-size: 0.8rem;
    color: var(--c-text-light);
    text-decoration: none;
    transition: color 0.2s;
  }
  .forgot-password:hover { color: var(--c-primary); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
    box-shadow: 0 4px 12px rgba(13,148,136,0.25);
  }
  .btn-primary:hover:not(:disabled) {
    transform: scale(1.02);
    box-shadow: 0 8px 20px rgba(13,148,136,0.3);
  }
  .btn-primary:active:not(:disabled) { transform: scale(0.98); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
  .w-full { width: 100%; min-width: 180px; }
  .btn-primary .loading-spinner { display: inline-block; vertical-align: middle; }

  .loading-spinner {
    width: 18px; height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .auth-hint {
    text-align: center;
    font-size: 0.75rem;
    color: var(--c-text-light);
    padding: 0.5rem;
    background: rgba(13,148,136,0.06);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(13,148,136,0.1);
  }

  .hidden { display: none !important; }

  .recovery-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    animation: fadeIn 0.2s ease-out;
  }
  .recovery-modal {
    background: var(--c-bg, #fff);
    border-radius: 16px;
    width: 90%;
    max-width: 400px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    overflow: hidden;
  }
  .recovery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem 0;
  }
  .recovery-header h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--c-text);
  }
  .recovery-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--c-text-light);
    cursor: pointer;
    line-height: 1;
  }
  .recovery-close:hover { color: var(--c-text); }
  .recovery-body { padding: 1rem 1.5rem; }
  .recovery-desc {
    font-size: 0.8rem;
    color: var(--c-text-light);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .recovery-success {
    font-size: 0.85rem;
    color: var(--c-primary, #059669);
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .recovery-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1rem 1.5rem 1.25rem;
  }
  .recovery-btn-cancel {
    padding: 0.5rem 1rem;
    border: 1px solid var(--c-glass-border);
    border-radius: var(--radius-md);
    background: none;
    color: var(--c-text);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  .recovery-btn-cancel:hover { background: rgba(0,0,0,0.05); }
</style>
