---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const today = new Date();
const currentMonth = today.getMonth();
---

<Layout title="Deudas - DentFinance">
  <div class="page">
    <header class="page-header">
      <div>
        <h1 class="page-title">Estado de Deudas</h1>
        <p class="page-subtitle">Control de cuentas por cobrar separado por origen</p>
      </div>
      <div class="page-header-stats">
        <div class="stat-chip">
          <span class="stat-chip-label">Pendiente</span>
          <span class="stat-chip-value" id="statPending" style="color: var(--c-danger)">S/ 0</span>
        </div>
        <div class="stat-chip">
          <span class="stat-chip-label">Cobrado</span>
          <span class="stat-chip-value" id="statPaid" style="color: var(--c-success)">S/ 0</span>
        </div>
        <div class="stat-chip">
          <span class="stat-chip-label">Deudas</span>
          <span class="stat-chip-value" id="statCount">0</span>
        </div>
      </div>
    </header>

    <div class="layout">
      <!-- Form -->
      <div class="glass-card form-section">
        <div class="section-head">
          <div class="section-head-icon">
            <Icon name="plus" size={20} />
          </div>
          <div>
            <h2 class="section-title" id="formTitle">Nueva Deuda</h2>
            <p class="section-desc" id="formDesc">Registra una nueva deuda</p>
          </div>
        </div>

        <form id="debt-form" class="debt-form" novalidate>
          <div class="form-group">
            <label class="form-label">Origen</label>
            <div class="radio-row">
              <label class="radio-card">
                <input type="radio" name="source" value="Clínica" checked />
                <span class="radio-content">
                  <Icon name="building" size={22} />
                  <span class="radio-title">Clínica</span>
                </span>
              </label>
              <label class="radio-card">
                <input type="radio" name="source" value="Externo" />
                <span class="radio-content">
                  <Icon name="map-pin" size={22} />
                  <span class="radio-title">Fuera de Local</span>
                </span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label for="debt-patient" class="form-label">Paciente / Deudor</label>
            <div class="input-wrap">
              <span class="input-icon"><Icon name="user" size={16} /></span>
              <input type="text" id="debt-patient" name="patient" placeholder="Nombre del paciente" class="form-input" required />
            </div>
          </div>

          <div class="form-group">
            <label for="debt-desc" class="form-label">Descripción</label>
            <div class="input-wrap">
              <span class="input-icon"><Icon name="file-text" size={16} /></span>
              <input type="text" id="debt-desc" name="description" placeholder="Concepto de la deuda" class="form-input" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-1">
              <label for="debt-amount" class="form-label">Monto (S/)</label>
              <div class="input-wrap">
                <span class="input-icon"><Icon name="dollar-sign" size={16} /></span>
                <input type="number" id="debt-amount" name="amount" placeholder="0.00" step="0.01" min="0" class="form-input" required />
              </div>
            </div>
            <div class="form-group flex-1">
              <label for="debt-due" class="form-label">Fecha de Vencimiento</label>
              <div class="input-wrap">
                <span class="input-icon"><Icon name="calendar" size={16} /></span>
                <input type="date" id="debt-due" name="dueDate" class="form-input" required />
              </div>
            </div>
          </div>

          <div class="form-divider" />

          <div class="form-group">
            <label class="form-label">Comprobante (opcional)</label>
            <div class="voucher-upload" id="voucher-area">
              <input type="file" id="debt-voucher" name="voucher" accept="image/*,.pdf" capture="environment" class="voucher-input" />
              <div class="voucher-content" id="debtVoucherContent">
                <div class="voucher-icon-wrap">
                  <Icon name="camera" class="voucher-icon" size={24} />
                </div>
                <span class="voucher-text">Subir Comprobante</span>
                <span class="voucher-subtext">Toca para abrir cámara o galería — JPG, PNG, PDF</span>
              </div>
              <img id="debt-voucher-preview" class="voucher-preview" alt="Vista previa" />
              <button type="button" class="voucher-clear hidden" id="debtVoucherClear">
                <Icon name="trash-2" size={14} />
                Eliminar comprobante
              </button>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-save" id="debtSubmitBtn">
              <Icon name="plus" size={18} />
              Guardar Deuda
            </button>
            <button type="button" class="btn-cancel hidden" id="debtCancelBtn">
              <Icon name="x" size={18} />
              Cancelar
            </button>
          </div>
        </form>
      </div>

      <!-- Debt sections -->
      <div class="debt-sections">
        <!-- Clinica Section -->
        <div class="glass-card">
          <div class="section-head">
            <div class="section-head-icon" style="background: rgba(13,148,136,0.1); color: #0D9488;">
              <Icon name="building" size={18} />
            </div>
            <div class="section-head-text">
              <h2 class="section-title">Clínica</h2>
              <p class="section-desc" id="descClinica">0 registros</p>
            </div>
            <select class="month-filter" data-section="clinica">
              <option value="-1">Mostrar hoy</option>
              {months.map((m, i) => <option value={i} selected={i === currentMonth}>{m}</option>)}
              <option value="99">Ver todos</option>
            </select>
            <button class="pdf-btn" data-section="clinica" title="Exportar PDF">
              <Icon name="file-text" size={16} />
              PDF
            </button>
          </div>
          <div class="debt-list" id="listClinica"></div>
          <div class="debt-empty hidden" id="emptyClinica">
            <Icon name="credit-card" size={24} />
            <span>No hay deudas de Clínica</span>
          </div>
        </div>

        <!-- Externo Section -->
        <div class="glass-card">
          <div class="section-head">
            <div class="section-head-icon" style="background: rgba(16,185,129,0.1); color: #10B981;">
              <Icon name="map-pin" size={18} />
            </div>
            <div class="section-head-text">
              <h2 class="section-title">Fuera de Local</h2>
              <p class="section-desc" id="descExterno">0 registros</p>
            </div>
            <select class="month-filter" data-section="externo">
              <option value="-1">Mostrar hoy</option>
              {months.map((m, i) => <option value={i} selected={i === currentMonth}>{m}</option>)}
              <option value="99">Ver todos</option>
            </select>
            <button class="pdf-btn" data-section="externo" title="Exportar PDF">
              <Icon name="file-text" size={16} />
              PDF
            </button>
          </div>
          <div class="debt-list" id="listExterno"></div>
          <div class="debt-empty hidden" id="emptyExterno">
            <Icon name="credit-card" size={24} />
            <span>No hay deudas de Externo</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal detalle -->
  <div class="dtl-overlay hidden" id="detailModal">
    <div class="dtl-panel">
      <div class="dtl-head">
        <div class="dtl-head-left">
          <div class="dtl-icon" style="background: rgba(217,119,6,0.1); color: #D97706;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/></svg>
          </div>
          <div>
            <div class="dtl-title">Detalle de Deuda</div>
            <span class="dtl-badge" id="mSource">Origen</span>
          </div>
        </div>
        <button class="dtl-close" id="modalClose">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="dtl-body">
        <div class="dtl-amount-row" style="background: rgba(217,119,6,0.05); border-color: rgba(217,119,6,0.08);">
          <span class="dtl-amount" id="mAmount">S/ 0</span>
          <span class="dtl-date" id="mStatus" style="font-size:0.78rem;font-weight:600;">—</span>
        </div>

        <div class="dtl-desc-box">
          <span class="dtl-desc-label">Paciente</span>
          <p class="dtl-desc" id="mPatient">—</p>
        </div>

        <div class="dtl-desc-box">
          <span class="dtl-desc-label">Descripción</span>
          <p class="dtl-desc" id="mDesc">—</p>
        </div>

        <div class="dtl-info-grid">
          <div class="dtl-info-item">
            <span class="dtl-info-label">Vencimiento</span>
            <span class="dtl-info-value" id="mDue">—</span>
          </div>
          <div class="dtl-info-item">
            <span class="dtl-info-label">Estado</span>
            <span class="dtl-info-value" id="mStatus2">—</span>
          </div>
        </div>

        <div class="dtl-voucher-box" id="mVoucherField" style="display:none">
          <div class="dtl-voucher-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
            <span>Comprobante</span>
          </div>
          <div class="dtl-voucher-img-wrap">
            <img id="mVoucherImg" class="dtl-voucher-img" alt="Comprobante" />
            <span id="voucherError" class="dtl-voucher-err">No se pudo cargar la imagen</span>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button class="modal-btn modal-btn-pay" id="modalPay">
          <Icon name="check" size={14} />
          Marcar como Pagado
        </button>
        <button class="modal-btn modal-btn-delete" id="modalDelete">
          <Icon name="trash-2" size={14} />
          Eliminar
        </button>
      </div>
    </div>
  </div>

  <!-- Print area -->
  <div id="printArea" class="print-area"></div>
</Layout>

<script>
  import { fetchDebts, addDebt, updateDebt, deleteDebtWithVoucher, uploadVoucher, getVoucherPreview } from '../lib/data';

  const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  let debtsData = [];
  let editingId = null;

  function parseDate(dateStr) {
    const parts = dateStr.split('-');
    if (parts.length === 3) {
      const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
      if (!isNaN(y) && !isNaN(m) && !isNaN(d)) return { day: d, month: m };
    }
    const dt = new Date(dateStr);
    if (!isNaN(dt.getTime())) return { day: dt.getDate(), month: dt.getMonth() };
    const sp = dateStr.split(' ');
    const sd = parseInt(sp[0]);
    const map = { 'ene':0,'feb':1,'mar':2,'abr':3,'may':4,'jun':5,'jul':6,'ago':7,'sep':8,'oct':9,'nov':10,'dic':11 };
    return { day: sd, month: map[(sp[1]||'').toLowerCase().slice(0,3)] ?? 0 };
  }

  function formatDate(dateStr) {
    const { day, month } = parseDate(dateStr);
    return String(day).padStart(2,'0') + ' ' + months[month].slice(0,3);
  }

  function isOverdue(dueDate) {
    if (!dueDate) return false;
    const { day, month } = parseDate(dueDate);
    const d = new Date();
    d.setHours(0,0,0,0);
    const due = new Date(d.getFullYear(), month, day);
    return due < d;
  }

  function getInitials(name) {
    return name.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase();
  }

  // Form elements
  const form = document.getElementById('debt-form');
  const submitBtn = document.getElementById('debtSubmitBtn');
  const cancelBtn = document.getElementById('debtCancelBtn');
  const formTitle = document.getElementById('formTitle');
  const formDesc = document.getElementById('formDesc');
  const patientInput = document.getElementById('debt-patient');
  const descInput = document.getElementById('debt-desc');
  const amountInput = document.getElementById('debt-amount');
  const dueInput = document.getElementById('debt-due');
  const sourceRadios = document.querySelectorAll('[name="source"]');
  const voucherInput = document.getElementById('debt-voucher');
  const previewImg = document.getElementById('debt-voucher-preview');
  const voucherArea = document.getElementById('voucher-area');
  const voucherContent = document.getElementById('debtVoucherContent');
  const voucherClear = document.getElementById('debtVoucherClear');

  // List elements
  const listClinica = document.getElementById('listClinica');
  const listExterno = document.getElementById('listExterno');
  const emptyClinica = document.getElementById('emptyClinica');
  const emptyExterno = document.getElementById('emptyExterno');
  const descClinica = document.getElementById('descClinica');
  const descExterno = document.getElementById('descExterno');

  // Stats
  const statPending = document.getElementById('statPending');
  const statPaid = document.getElementById('statPaid');
  const statCount = document.getElementById('statCount');

  // Modal
  const modal = document.getElementById('detailModal');
  const modalClose = document.getElementById('modalClose');
  const modalPay = document.getElementById('modalPay');
  const modalDelete = document.getElementById('modalDelete');
  const mPatient = document.getElementById('mPatient');
  const mDesc = document.getElementById('mDesc');
  const mAmount = document.getElementById('mAmount');
  const mSource = document.getElementById('mSource');
  const mStatus = document.getElementById('mStatus');
  const mStatus2 = document.getElementById('mStatus2');
  const mDue = document.getElementById('mDue');
  const mVoucherField = document.getElementById('mVoucherField');
  const mVoucherImg = document.getElementById('mVoucherImg');

  let selectedId = null;
  let currentFilterClinica = -1;
  let currentFilterExterno = -1;
  let pageClinica = 1, pageExterno = 1;
  const PER_PAGE = 10;

  // Voucher upload
  voucherInput?.addEventListener('change', function(e) {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(evt) {
        if (previewImg) {
          previewImg.src = evt.target?.result;
          previewImg.classList.add('show');
        }
        if (voucherContent) voucherContent.classList.add('hidden');
        if (voucherClear) voucherClear.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
      const text = voucherArea?.querySelector('.voucher-text');
      if (text) text.textContent = file.name;
    }
  });

  voucherClear?.addEventListener('click', function() {
    if (voucherInput) voucherInput.value = '';
    if (previewImg) { previewImg.classList.remove('show'); previewImg.src = ''; }
    if (voucherContent) voucherContent.classList.remove('hidden');
    if (voucherClear) voucherClear.classList.add('hidden');
    const text = voucherArea?.querySelector('.voucher-text');
    if (text) text.textContent = 'Subir Comprobante';
  });

  function escHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function renderSections() {
    const now = new Date();
    now.setHours(0,0,0,0);

    const renderSection = (listEl, emptyEl, descEl, filterVal, sourceType, page, setPage) => {
      const items = debtsData.filter(d => d.source === sourceType);
      const filtered = items.filter(d => {
        if (filterVal === -1) {
          const { day, month } = parseDate(d.dueDate);
          return day === now.getDate() && month === now.getMonth();
        }
        if (filterVal === 99) return true;
        const { month } = parseDate(d.dueDate);
        return month === filterVal;
      });

      const pendingSum = filtered.filter(d => d.status === 'Pendiente').reduce((s, d) => s + d.amount, 0);
      descEl.textContent = filtered.length + ' registros · S/ ' + pendingSum.toLocaleString('es-PE') + ' pend.';

      if (filtered.length === 0) {
        listEl.innerHTML = '';
        listEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      listEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');

      const totalPages = Math.ceil(filtered.length / PER_PAGE);
      if (page > totalPages) page = totalPages;
      const start = (page - 1) * PER_PAGE;
      const pageItems = filtered.slice(start, start + PER_PAGE);

      listEl.innerHTML = pageItems.map((d, i) => {
        const overdue = d.status === 'Pendiente' && isOverdue(d.dueDate);
        const statusLabel = d.status === 'Pendiente' ? 'Pendiente' : 'Pagado';
        return `
          <div class="d-item" data-id="${escHtml(String(d.id))}" data-source="${escHtml(d.source)}" style="animation-delay: ${i * 0.04}s">
            <div class="d-item-main">
              <div class="d-avatar">${escHtml(getInitials(d.patient))}</div>
              <div class="d-info">
                <div class="d-header">
                  <span class="d-patient">${escHtml(d.patient)}</span>
                  <span class="d-badge ${d.status.toLowerCase()}">${statusLabel}</span>
                  ${overdue ? '<span class="d-overdue-badge">Vencida</span>' : ''}
                </div>
                <span class="d-desc">${escHtml(d.description)}</span>
                <div class="d-meta">
                  <span class="d-amount">S/ ${d.amount.toLocaleString('es-PE')}</span>
                  <span class="d-sep">•</span>
                  <span class="d-due ${overdue ? 'overdue' : ''}">Vence: ${escHtml(d.dueDate)}</span>
                </div>
              </div>
              <div class="d-right">
                <span class="d-source ${d.source === 'Clínica' ? 'clinica' : 'externo'}">${d.source === 'Clínica' ? 'Clínica' : 'Ext.'}</span>
                <button class="d-toggle" onclick="window.openDebtModal('${escHtml(String(d.id))}')">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                </button>
                <button class="d-action-btn d-edit-btn" onclick="window.editDebt('${escHtml(String(d.id))}')" aria-label="Editar">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                </button>
                <button class="d-action-btn d-pay-btn" onclick="window.payDebt('${escHtml(String(d.id))}')" aria-label="Pagar" title="Marcar como Pagado">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      if (totalPages > 1) {
        let pagHtml = '<div class="pagination" data-section="' + sourceType + '">';
        if (page > 1) pagHtml += `<button class="pag-btn" data-page="${page - 1}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg> Anterior</button>`;
        for (let p = 1; p <= totalPages; p++) {
          const active = p === page ? ' active' : '';
          pagHtml += `<button class="pag-btn${active}" data-page="${p}">${p}</button>`;
        }
        if (page < totalPages) pagHtml += `<button class="pag-btn" data-page="${page + 1}">Siguiente <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></button>`;
        pagHtml += '</div>';
        listEl.insertAdjacentHTML('beforeend', pagHtml);
      }
    };

    renderSection(listClinica, emptyClinica, descClinica, currentFilterClinica, 'Clínica', pageClinica, (v) => { pageClinica = v; });
    renderSection(listExterno, emptyExterno, descExterno, currentFilterExterno, 'Externo', pageExterno, (v) => { pageExterno = v; });
    updateStats();
  }

  function updateStats() {
    const pending = debtsData.filter(d => d.status === 'Pendiente').reduce((s, d) => s + d.amount, 0);
    const paid = debtsData.filter(d => d.status === 'Pagado').reduce((s, d) => s + d.amount, 0);
    statPending.textContent = 'S/ ' + pending.toLocaleString('es-PE');
    statPaid.textContent = 'S/ ' + paid.toLocaleString('es-PE');
    statCount.textContent = debtsData.length;
  }

  // Pagination clicks
  document.addEventListener('click', function(e) {
    const pagBtn = e.target.closest('.pag-btn');
    if (!pagBtn) return;
    const pagWrap = pagBtn.closest('.pagination');
    if (!pagWrap) return;
    const section = pagWrap.dataset.section;
    const p = parseInt(pagBtn.dataset.page);
    if (section === 'Clínica') { pageClinica = p; }
    else if (section === 'Externo') { pageExterno = p; }
    renderSections();
  });

  // Month filters
  document.querySelectorAll('.month-filter').forEach(sel => {
    sel.addEventListener('change', function() {
      const section = this.dataset.section;
      if (section === 'clinica') {
        currentFilterClinica = parseInt(this.value);
        pageClinica = 1;
      } else {
        currentFilterExterno = parseInt(this.value);
        pageExterno = 1;
      }
      renderSections();
    });
  });

  // Form submit
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = new FormData(this);
    const patient = data.get('patient');
    const description = data.get('description');
    const amount = parseFloat(data.get('amount'));
    const dueDate = data.get('dueDate');
    const source = data.get('source') || 'Clínica';
    if (!patient || !description || !amount || !dueDate) {
      window.showToast('Completa todos los campos obligatorios.', 'error');
      return;
    }
    let file = voucherInput?.files?.[0] || null;

    if (editingId) {
      const event = new CustomEvent('update-debt', {
        detail: { id: editingId, patient, description, amount, dueDate, source, file }
      });
      document.dispatchEvent(event);
    } else {
      const event = new CustomEvent('new-debt', {
        detail: { patient, description, amount, dueDate, source, file }
      });
      document.dispatchEvent(event);
    }
    resetForm();
  });

  document.addEventListener('new-debt', async function(e) {
    const debt = e.detail;
    try {
      let voucher = '';
      if (debt.file) {
        try {
          voucher = await uploadVoucher(debt.file);
        } catch (err) {
          console.warn('Error uploading voucher, debt will be saved without image:', err);
        }
      }
      const created = await addDebt({
        patient: debt.patient,
        description: debt.description,
        amount: debt.amount,
        dueDate: debt.dueDate,
        source: debt.source,
        voucher
      });
      debt.id = created.$id;
      debt.voucher = voucher;
      debt.status = 'Pendiente';
      debtsData.unshift({ ...debt });
      renderSections();
      window.showToast('Deuda registrada correctamente.', 'success');
    } catch (err) {
      console.error('Error saving debt to Appwrite:', err);
      window.showToast('Error al guardar la deuda.', 'error');
    }
  });

  document.addEventListener('update-debt', async function(e) {
    const debt = e.detail;
    try {
      const updateData = {
        patient: debt.patient,
        description: debt.description,
        amount: debt.amount,
        dueDate: debt.dueDate,
        source: debt.source,
      };
      let voucher = '';
      if (debt.file) {
        try {
          voucher = await uploadVoucher(debt.file);
          updateData.voucher = voucher;
        } catch (err) {
          console.warn('Error uploading voucher:', err);
        }
      }
      await updateDebt(debt.id, updateData);
      const idx = debtsData.findIndex(d => String(d.id) === String(debt.id));
      if (idx >= 0) {
        debtsData[idx] = { ...debtsData[idx], ...updateData, voucher: voucher || debtsData[idx].voucher };
      }
      editingId = null;
      renderSections();
      window.showToast('Deuda actualizada.', 'success');
    } catch (err) {
      console.error('Error updating debt:', err);
      window.showToast('Error al actualizar la deuda.', 'error');
    }
  });

  document.addEventListener('cancel-debt-edit', function() {
    editingId = null;
  });

  function resetForm() {
    editingId = null;
    form.reset();
    sourceRadios[0].checked = true;
    if (previewImg) { previewImg.classList.remove('show'); previewImg.src = ''; }
    if (voucherContent) voucherContent.classList.remove('hidden');
    if (voucherClear) voucherClear.classList.add('hidden');
    const text = voucherArea?.querySelector('.voucher-text');
    if (text) text.textContent = 'Subir Comprobante';
    if (voucherInput) voucherInput.value = '';
    submitBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg> Guardar Deuda';
    cancelBtn.classList.add('hidden');
    formTitle.textContent = 'Nueva Deuda';
    formDesc.textContent = 'Registra una nueva deuda';
  }

  cancelBtn.addEventListener('click', function() {
    resetForm();
    document.dispatchEvent(new CustomEvent('cancel-debt-edit'));
  });

  // Global functions for inline onclick handlers
  window.openDebtModal = async function(id) {
    const d = debtsData.find(x => String(x.id) === String(id));
    if (!d) return;
    selectedId = d.id;
    mPatient.textContent = d.patient;
    mDesc.textContent = d.description;
    mAmount.textContent = 'S/ ' + d.amount.toLocaleString('es-PE');
    mSource.textContent = d.source;
    const statusLabel = d.status === 'Pendiente' ? 'Pendiente' : 'Pagado';
    mStatus.textContent = statusLabel;
    mStatus.style.color = d.status === 'Pendiente' ? '#D97706' : '#059669';
    mStatus2.textContent = statusLabel;
    mStatus2.style.color = d.status === 'Pendiente' ? '#D97706' : '#059669';
    mDue.textContent = d.dueDate;
    mDue.style.color = d.status === 'Pendiente' && isOverdue(d.dueDate) ? '#DC2626' : 'inherit';

    if (d.voucher && mVoucherField && mVoucherImg) {
      mVoucherField.style.display = '';
      const errEl = document.getElementById('voucherError');
      try {
        const url = getVoucherPreview(d.voucher);
        const resp = await fetch(url);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const blob = await resp.blob();
        mVoucherImg.src = URL.createObjectURL(blob);
        mVoucherImg.style.display = '';
        if (errEl) errEl.style.display = 'none';
      } catch (err) {
        console.warn('Failed to load voucher image:', err);
        mVoucherImg.style.display = 'none';
        if (errEl) errEl.style.display = '';
      }
    } else if (mVoucherField) {
      mVoucherField.style.display = 'none';
    }

    modal.classList.remove('hidden');
    modal.classList.add('visible');
  };

  window.editDebt = function(id) {
    const d = debtsData.find(x => String(x.id) === String(id));
    if (!d) return;
    editingId = d.id;
    document.querySelector('[name="source"][value="' + d.source + '"]').checked = true;
    patientInput.value = d.patient;
    descInput.value = d.description;
    amountInput.value = d.amount;
    dueInput.value = d.dueDate;
    submitBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg> Actualizar Deuda';
    cancelBtn.classList.remove('hidden');
    formTitle.textContent = 'Editar Deuda';
    formDesc.textContent = 'Modifica los datos de la deuda';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  window.payDebt = async function(id) {
    const d = debtsData.find(x => String(x.id) === String(id));
    if (!d || d.status !== 'Pendiente') return;
    try {
      await updateDebt(id, { status: 'Pagado' });
      d.status = 'Pagado';
      renderSections();
      window.showToast('Deuda marcada como pagada.', 'success');
    } catch (err) {
      console.error('Error updating debt status:', err);
      window.showToast('Error al actualizar la deuda.', 'error');
    }
  };

  // Modal buttons
  function closeModal() {
    modal.classList.remove('visible');
    modal.classList.add('hidden');
    selectedId = null;
  }
  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  modalPay.addEventListener('click', async function() {
    if (!selectedId) return;
    const d = debtsData.find(x => String(x.id) === String(selectedId));
    if (d && d.status === 'Pendiente') {
      try {
        await updateDebt(selectedId, { status: 'Pagado' });
        d.status = 'Pagado';
        closeModal();
        renderSections();
        window.showToast('Deuda marcada como pagada.', 'success');
      } catch (err) {
        console.error('Error updating debt status:', err);
        window.showToast('Error al actualizar la deuda.', 'error');
      }
    }
  });

  modalDelete.addEventListener('click', async function() {
    if (!selectedId) return;
    const d = debtsData.find(x => String(x.id) === String(selectedId));
    const ok = await window.showConfirm('¿Eliminar esta deuda?');
    if (!ok) return;
    try {
      await deleteDebtWithVoucher(selectedId, d?.voucher);
      debtsData = debtsData.filter(x => String(x.id) !== String(selectedId));
      closeModal();
      renderSections();
      window.showToast('Deuda eliminada.', 'success');
    } catch (err) {
      console.error('Error deleting debt:', err);
      window.showToast('Error al eliminar la deuda.', 'error');
    }
  });

  // Export PDF
  document.querySelectorAll('.pdf-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      const section = this.dataset.section;
      const sourceType = section === 'clinica' ? 'Clínica' : 'Externo';
      const filterVal = section === 'clinica' ? currentFilterClinica : currentFilterExterno;
      const now = new Date();

      const items = debtsData.filter(d => d.source === sourceType);
      const filtered = items.filter(d => {
        if (filterVal === -1) {
          const { day, month } = parseDate(d.dueDate);
          return day === now.getDate() && month === now.getMonth();
        }
        if (filterVal === 99) return true;
        const { month } = parseDate(d.dueDate);
        return month === filterVal;
      });

      if (filtered.length === 0) {
        window.showToast('No hay deudas para exportar.', 'info');
        return;
      }

      const label = filterVal === -1 ? 'Hoy' : filterVal === 99 ? 'Todos' : months[filterVal];
      const total = filtered.reduce((s, d) => s + d.amount, 0);
      const pendingCount = filtered.filter(d => d.status === 'Pendiente').length;
      const paidCount = filtered.filter(d => d.status === 'Pagado').length;

      const rows = await Promise.all(filtered.map(async (d) => {
        const overdue = d.status === 'Pendiente' && isOverdue(d.dueDate);
        let imgHtml = '';
        if (d.voucher) {
          try {
            const url = getVoucherPreview(d.voucher);
            const resp = await fetch(url);
            if (resp.ok) {
              const blob = await resp.blob();
              const dataUrl = await new Promise((resolve) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result);
                reader.readAsDataURL(blob);
              });
              imgHtml = `<img src="${dataUrl}" class="print-voucher" />`;
            }
          } catch (_) {}
        }
        const statusLabel = d.status === 'Pendiente' ? (overdue ? 'Vencida' : 'Pendiente') : 'Pagado';
        return `<tr><td>${escHtml(d.dueDate)}</td><td>${escHtml(d.patient)}</td><td>${escHtml(d.description)}</td><td style="text-align:right">S/ ${d.amount.toLocaleString('es-PE')}</td><td>${statusLabel}</td><td>${imgHtml}</td></tr>`;
      }));
      const rowsHtml = rows.join('');

      const printArea = document.getElementById('printArea');
      printArea.innerHTML = `
        <div class="print-header">
          <div class="print-brand">
            <svg class="print-logo" viewBox="0 0 128 128" width="36" height="36"><rect width="128" height="128" rx="28" fill="#0D9488"/><path d="M64 28c-21 0-32 11-32 30 0 19 4 40 10 54 2 6 5 16 11 16 3 0 6-2 9-4l2-2 2 2c3 2 6 4 9 4 6 0 9-10 11-16 6-14 10-35 10-54 0-19-11-30-32-30z" fill="#fff"/><path d="M50 44c5-4 10-6 14-6s9 2 14 6" fill="none" stroke="#0D9488" stroke-width="4" stroke-linecap="round"/></svg>
            <div>
              <div class="print-brand-name">DentFinance</div>
              <div class="print-brand-tag">Sistema de Gestión Dental</div>
            </div>
          </div>
          <div class="print-title-block">
            <h1 class="print-title">Reporte de Deudas — ${sourceType}</h1>
            <p class="print-period">${label} · ${now.getFullYear()}</p>
          </div>
          <div class="print-meta">
            <span>Generado: ${now.toLocaleDateString('es-PE', { year:'numeric', month:'long', day:'numeric' })}</span>
            <span>${now.toLocaleTimeString('es-PE', { hour:'2-digit', minute:'2-digit' })}</span>
          </div>
        </div>
        <div class="print-summary">
          <div class="print-summary-item">
            <span class="print-summary-label">Total Deudas</span>
            <span class="print-summary-value">S/ ${total.toLocaleString('es-PE')}</span>
          </div>
          <div class="print-summary-item">
            <span class="print-summary-label">Pendientes</span>
            <span class="print-summary-value">${pendingCount}</span>
          </div>
          <div class="print-summary-item">
            <span class="print-summary-label">Pagadas</span>
            <span class="print-summary-value">${paidCount}</span>
          </div>
          <div class="print-summary-item">
            <span class="print-summary-label">Periodo</span>
            <span class="print-summary-value">${label}</span>
          </div>
        </div>
        <table class="print-table">
          <thead><tr><th>Vencimiento</th><th>Paciente</th><th>Descripción</th><th>Monto</th><th>Estado</th><th>Comprobante</th></tr></thead>
          <tbody>${rowsHtml}</tbody>
          <tfoot><tr><td colspan="3" style="text-align:right;font-weight:700;font-size:0.85rem">Total</td><td style="text-align:right;font-weight:700;font-size:0.85rem">S/ ${total.toLocaleString('es-PE')}</td><td></td><td></td></tr></tfoot>
        </table>
        <div class="print-footer">
          <p>DentFinance © ${now.getFullYear()} — Reporte generado automáticamente</p>
        </div>
      `;
      printArea.classList.add('print-active');
      window.print();
      setTimeout(() => {
        printArea.classList.remove('print-active');
        printArea.innerHTML = '';
      }, 1000);
    });
  });

  // Init
  async function init() {
    try {
      const docs = await fetchDebts();
      debtsData = docs.map(d => ({
        id: d.$id,
        patient: d.patient || '',
        description: d.description || '',
        amount: Number(d.amount) || 0,
        dueDate: d.dueDate || d.$createdAt,
        source: d.source || 'Clínica',
        status: d.status || 'Pendiente',
        voucher: d.voucher || ''
      }));
    } catch (err) {
      console.warn('No se pudieron cargar las deudas desde Appwrite:', err);
    }
    renderSections();
    checkOverdueDebts();
  }

  function checkOverdueDebts() {
    const overdue = debtsData.filter(d => d.status === 'Pendiente' && isOverdue(d.dueDate));
    if (overdue.length > 0) {
      const total = overdue.reduce((s, d) => s + d.amount, 0);
      const names = overdue.map(d => d.patient).slice(0, 3).join(', ');
      const more = overdue.length > 3 ? ` y ${overdue.length - 3} más` : '';
      window.showToast(`🔔 ${overdue.length} deuda${overdue.length > 1 ? 's' : ''} vencida${overdue.length > 1 ? 's' : ''} — S/ ${total.toLocaleString('es-PE')} (${names}${more})`, 'warning', 8000);
      // Mark overdue as read in session so it only alerts once per session
      sessionStorage.setItem('df_overdue_notified', 'true');
    }
  }

  // Re-check overdue every 5 minutes
  setInterval(checkOverdueDebts, 300000);

  init();
</script>

