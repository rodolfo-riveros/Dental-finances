---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const defaultServices = [
  { id: 1, title: 'Limpieza Dental', desc: 'Eliminación de placa y sarro para una sonrisa saludable', price: 150, color: '#0D9488', category: 'Clínica' },
  { id: 2, title: 'Blanqueamiento', desc: 'Recupera el brillo natural de tus dientes', price: 300, color: '#8B5CF6', category: 'Clínica' },
  { id: 3, title: 'Ortodoncia', desc: 'Alineación dental con tecnología de punta', price: 1200, color: '#3B82F6', category: 'Externo' },
  { id: 4, title: 'Implantes', desc: 'Solución permanente para dientes perdidos', price: 1500, color: '#EC4899', category: 'Externo' },
  { id: 5, title: 'Endodoncia', desc: 'Tratamiento de conducto sin dolor', price: 400, color: '#F59E0B', category: 'Clínica' },
  { id: 6, title: 'Extracciones', desc: 'Procedimientos rápidos y seguros', price: 250, color: '#EF4444', category: 'Externo' },
];
const colors = ['#0D9488','#8B5CF6','#3B82F6','#EC4899','#F59E0B','#EF4444','#10B981','#6366F1'];
const categories = ['Clínica', 'Externo'];
const svcCount = defaultServices.length;
---

<Layout title="Ajustes - DentFinance">
  <div class="page">
    <header class="page-header">
      <div>
        <div class="hdr-badge">
          <Icon name="settings" size={12} />
          <span>Configuración</span>
        </div>
        <h1 class="page-title">Ajustes de la Clínica</h1>
        <p class="page-subtitle">Personaliza el nombre de tu clínica y administra los servicios que ofreces</p>
      </div>
      <div class="page-header-stats">
        <div class="stat-chip">
          <span class="stat-chip-value">{svcCount}</span>
          <span class="stat-chip-label">Servicios</span>
        </div>
        <div class="stat-chip">
          <span class="stat-chip-value" id="clinicStat">—</span>
          <span class="stat-chip-label">Clínica</span>
        </div>
        <button class="stat-chip" id="replayTour" title="Ver tour de bienvenida" style="cursor:pointer;border:1px solid var(--c-glass-border);background:var(--c-glass);font-family:var(--font-sans)">
          <span style="font-size:0.72rem;font-weight:600;color:var(--c-text);display:flex;align-items:center;gap:0.25rem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z"/></svg>
            Tour
          </span>
        </button>
      </div>
    </header>

    <!-- Clinic Info -->
    <section class="settings-section">
      <div class="aj-orb" style="top: -60px; right: -40px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(13,148,136,0.08), transparent)" />
      <div class="section-head">
        <div class="section-icon" style="background: rgba(13,148,136,0.1); color: var(--c-primary)">
          <Icon name="building" size={18} />
        </div>
        <div class="section-head-text">
          <h2 class="section-title">Información de la Clínica</h2>
          <p class="section-desc">Este nombre se mostrará en toda la aplicación</p>
        </div>
      </div>
      <div class="clinic-form">
        <div class="input-wrap" style="flex:1">
          <div class="input-icon"><Icon name="building" size={16} /></div>
          <input type="text" class="form-input" id="clinicName" placeholder="Ej: Clínica Dental Sonrisas" />
        </div>
        <div class="input-wrap" style="flex:1">
          <div class="input-icon"><Icon name="mail" size={16} /></div>
          <input type="email" class="form-input" id="clinicEmail" placeholder="correo@clinica.com" />
        </div>
        <button class="btn-save" id="saveClinic">
          <Icon name="check" size={14} />
          <span>Guardar</span>
        </button>
      </div>
    </section>

    <!-- Services -->
    <section class="settings-section">
      <div class="aj-orb" style="bottom: -50px; left: -30px; width: 180px; height: 180px; background: radial-gradient(circle, rgba(139,92,246,0.08), transparent)" />
      <div class="section-head">
        <div class="section-icon" style="background: rgba(139,92,246,0.1); color: #8B5CF6">
          <Icon name="clipboard-list" size={18} />
        </div>
        <div class="section-head-text">
          <h2 class="section-title">Servicios</h2>
          <p class="section-desc">Administra los tratamientos y procedimientos que ofrece tu clínica</p>
        </div>
        <button class="btn-add" id="addService">
          <Icon name="plus" size={14} />
          Nuevo
        </button>
      </div>
      <div class="services-grid" id="servicesGrid"></div>
    </section>
  </div>

  <!-- Modal -->
  <div class="modal-overlay hidden" id="serviceModal">
    <div class="modal-panel">
      <div class="modal-header">
        <h3 class="modal-title" id="modalTitle">Nuevo Servicio</h3>
        <button class="modal-close" id="modalClose"><Icon name="x" size={18} /></button>
      </div>
      <div class="modal-body">

        <!-- Información básica -->
        <div class="aj-field">
          <label class="aj-label">
            <Icon name="clipboard-list" size={12} />
            Nombre del Servicio
          </label>
          <div class="input-wrap">
            <input type="text" class="form-input aj-input-solo" id="svcTitle" placeholder="Ej: Limpieza Dental" />
          </div>
        </div>

        <div class="aj-field">
          <label class="aj-label">
            <Icon name="file-text" size={12} />
            Descripción
          </label>
          <div class="input-wrap">
            <textarea class="form-input aj-textarea" id="svcDesc" placeholder="Breve descripción del servicio"></textarea>
          </div>
        </div>

        <div class="aj-row">
          <div class="aj-field" style="flex:1">
            <label class="aj-label">
              <Icon name="dollar-sign" size={12} />
              Precio
            </label>
            <div class="input-wrap">
              <span class="aj-currency">S/</span>
              <input type="number" class="form-input aj-input-currency" id="svcPrice" placeholder="150" min="0" />
            </div>
          </div>
          <div class="aj-field" style="flex:1">
            <label class="aj-label">
              <Icon name="tag" size={12} />
              Categoría
            </label>
            <div class="input-wrap">
              <select class="form-input" id="svcCategory">
                {categories.map(c => <option value={c}>{c}</option>)}
              </select>
            </div>
          </div>
        </div>

        <!-- Color -->
        <div class="aj-field">
          <label class="aj-label">
            <Icon name="palette" size={12} />
            Color del servicio
          </label>
          <div class="aj-color-section">
            <div class="color-picker" id="colorPicker">
              {colors.map(c => (
                <button class="color-swatch" data-color={c} style={`background: ${c}`} />
              ))}
            </div>
            <div class="aj-color-custom">
              <input type="color" id="svcColorPicker" value="#0D9488" />
              <input type="text" class="form-input aj-input-hex" id="svcColorHex" value="#0D9488" maxlength="7" />
            </div>
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button class="modal-btn-cancel" id="modalCancel">Cancelar</button>
        <button class="modal-btn-save" id="modalSaveService">
          <Icon name="check" size={14} />
          Guardar Servicio
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { fetchServices, addService, updateService, deleteService, fetchClinic, saveClinic } from '../lib/data';

  let services = [];
  let editingId = null;
  let selectedColor = '#0D9488';

  // --- Clinic ---
  async function loadClinic() {
    try {
      const clinic = await fetchClinic();
      if (clinic) {
        document.getElementById('clinicName').value = clinic.name || '';
        document.getElementById('clinicEmail').value = clinic.email || '';
        document.getElementById('clinicStat').textContent = clinic.name || '—';
        localStorage.setItem('df_clinic', clinic.name || '');
      }
    } catch (err) {
      const name = localStorage.getItem('df_clinic') || 'Clinica Dental';
      document.getElementById('clinicName').value = name;
      document.getElementById('clinicStat').textContent = name;
    }
  }

  document.getElementById('saveClinic').addEventListener('click', async () => {
    const name = document.getElementById('clinicName').value.trim() || 'Clinica Dental';
    const email = document.getElementById('clinicEmail').value.trim() || '';
    try {
      await saveClinic({ name, email });
      document.getElementById('clinicStat').textContent = name;
      localStorage.setItem('df_clinic', name);
      window.showToast('Información de clínica actualizada.', 'success');
    } catch (err) {
      console.error('Error saving clinic:', err);
      window.showToast('Error al guardar.', 'error');
    }
  });

  // --- Services ---
  async function loadServices() {
    try {
      const docs = await fetchServices();
      services = docs.map(d => ({
        id: d.$id,
        title: d.title || '',
        desc: d.desc || '',
        price: Number(d.price) || 0,
        category: d.category || 'Clínica',
        color: d.color || '#0D9488',
      }));
      document.querySelector('.stat-chip .stat-chip-value').textContent = services.length;
    } catch (err) {
      console.warn('Error fetching services:', err);
    }
    renderServices();
  }

  function renderServices() {
    const grid = document.getElementById('servicesGrid');
    if (services.length === 0) {
      grid.innerHTML = `<div class="list-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg><span>No hay servicios registrados</span><button class="btn-add-empty" onclick="document.getElementById('addService').click()">+ Agregar Servicio</button></div>`;
      return;
    }
    grid.innerHTML = services.map((s, i) => `
      <div class="svc-card" data-id="${esc(s.id)}" style="animation-delay: ${i * 0.05}s">
        <div class="svc-card-accent" style="background: linear-gradient(90deg, ${s.color}, ${s.color}44)"></div>
        <div class="svc-card-body">
          <div class="svc-card-top">
            <div class="svc-card-icon" style="background: ${s.color}18; color: ${s.color}; box-shadow: 0 4px 12px ${s.color}22">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg>
            </div>
            <span class="svc-category" style="background: ${s.category === 'Clínica' ? 'rgba(13,148,136,0.12)' : 'rgba(16,185,129,0.12)'}; color: ${s.category === 'Clínica' ? '#0D9488' : '#10B981'}">${s.category}</span>
          </div>
          <h3 class="svc-title">${esc(s.title)}</h3>
          <p class="svc-desc">${esc(s.desc)}</p>
          <div class="svc-price" style="color: ${s.color}">S/ ${s.price.toLocaleString('es-PE')}</div>
          <div class="svc-actions">
            <button class="svc-btn svc-btn-edit" onclick="editService('${esc(s.id)}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
              Editar
            </button>
            <button class="svc-btn svc-btn-del" onclick="deleteService('${esc(s.id)}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            </button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  const modal = document.getElementById('serviceModal');
  const modalClose = document.getElementById('modalClose');
  const modalCancel = document.getElementById('modalCancel');
  const modalSave = document.getElementById('modalSaveService');
  const modalTitle = document.getElementById('modalTitle');
  const svcTitle = document.getElementById('svcTitle');
  const svcDesc = document.getElementById('svcDesc');
  const svcPrice = document.getElementById('svcPrice');
  const svcCategory = document.getElementById('svcCategory');
  const colorPicker = document.getElementById('colorPicker');
  const svcColorPicker = document.getElementById('svcColorPicker');
  const svcColorHex = document.getElementById('svcColorHex');

  function setColor(color) {
    selectedColor = color;
    svcColorPicker.value = color;
    svcColorHex.value = color;
    document.querySelectorAll('.color-swatch').forEach(el => el.classList.toggle('selected', el.dataset.color === color));
  }

  function openModal(editData) {
    editingId = editData ? editData.id : null;
    modalTitle.textContent = editData ? 'Editar Servicio' : 'Nuevo Servicio';
    svcTitle.value = editData ? editData.title : '';
    svcDesc.value = editData ? editData.desc : '';
    svcPrice.value = editData ? editData.price : '';
    svcCategory.value = editData ? editData.category : 'Clínica';
    setColor(editData ? editData.color : '#0D9488');
    modal.classList.remove('hidden');
    modal.classList.add('visible');
    setTimeout(() => svcTitle.focus(), 100);
  }

  function closeModalFn() { modal.classList.remove('visible'); modal.classList.add('hidden'); editingId = null; }
  document.getElementById('addService').addEventListener('click', () => openModal(null));
  modalClose.addEventListener('click', closeModalFn);
  modalCancel.addEventListener('click', closeModalFn);
  modal.addEventListener('click', e => { if (e.target === modal) closeModalFn(); });

  colorPicker.addEventListener('click', e => {
    const swatch = e.target.closest('.color-swatch');
    if (!swatch) return;
    setColor(swatch.dataset.color);
  });

  svcColorPicker.addEventListener('input', () => setColor(svcColorPicker.value));
  svcColorHex.addEventListener('input', () => {
    if (/^#[0-9a-fA-F]{6}$/.test(svcColorHex.value)) setColor(svcColorHex.value);
  });

  modalSave.addEventListener('click', async () => {
    const title = svcTitle.value.trim();
    const desc = svcDesc.value.trim();
    const price = parseFloat(svcPrice.value);
    const category = svcCategory.value;
    if (!title || !desc || isNaN(price) || price <= 0) {
      const missing = [];
      if (!title) missing.push('Nombre');
      if (!desc) missing.push('Descripción');
      if (isNaN(price) || price <= 0) missing.push('Precio');
      window.showToast('Campos obligatorios: ' + missing.join(', '), 'error');
      return;
    }

    try {
      if (editingId) {
        await updateService(editingId, { title, desc, price, category, color: selectedColor });
      } else {
        await addService({ title, desc, price, category, color: selectedColor });
      }
      await loadServices();
      closeModalFn();
      window.showToast(editingId ? 'Servicio actualizado.' : 'Servicio creado.', 'success');
    } catch (err) {
      console.error('Error saving service:', err);
      window.showToast('Error al guardar servicio.', 'error');
    }
  });

  window.editService = function(id) { const s = services.find(x => x.id === id); if (s) openModal(s); };
  window.deleteService = async function(id) {
    const ok = await window.showConfirm('¿Eliminar este servicio?');
    if (!ok) return;
    try {
      await deleteService(id);
      await loadServices();
      window.showToast('Servicio eliminado.', 'success');
    } catch (err) {
      console.error('Error deleting service:', err);
      window.showToast('Error al eliminar.', 'error');
    }
  };

  document.getElementById('replayTour').addEventListener('click', () => {
    localStorage.removeItem('df_tour_complete');
    window.location.href = '/dashboard';
  });

  loadClinic();
  loadServices();
</script>

<style is:global>
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

  .page { max-width: 960px; margin: 0 auto; padding: 0 1rem; }

  .page-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.75rem;
  }
  .hdr-badge {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: rgba(13,148,136,0.08); color: var(--c-primary);
    padding: 0.25rem 0.7rem; border-radius: 20px;
    font-size: 0.65rem; font-weight: 600; margin-bottom: 0.5rem;
    border: 1px solid rgba(13,148,136,0.1);
  }
  .page-title { font-size: 1.5rem; font-weight: 700; color: var(--c-text); letter-spacing: -0.02em; line-height: 1.3; }
  .page-subtitle { font-size: 0.82rem; color: var(--c-text-light); margin-top: 0.1rem; max-width: 420px; }

  .page-header-stats { display: flex; gap: 0.5rem; }
  .stat-chip {
    padding: 0.45rem 0.8rem; background: var(--c-glass);
    border: 1px solid var(--c-glass-border); border-radius: 8px;
    display: flex; flex-direction: column; align-items: center; gap: 0.05rem;
  }
  .stat-chip-value { font-size: 0.9rem; font-weight: 700; color: var(--c-text); }
  .stat-chip-label { font-size: 0.58rem; color: var(--c-text-light); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 500; }

  /* Section */
  .settings-section {
    position: relative; overflow: hidden;
    background: var(--c-glass); backdrop-filter: blur(12px);
    border: 1px solid var(--c-glass-border); border-radius: var(--radius-lg);
    padding: 1.25rem; box-shadow: var(--shadow-md);
    animation: fadeUp 0.4s ease both;
  }
  .settings-section + .settings-section { margin-top: 1rem; animation-delay: 0.05s; }
  .aj-orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(40px); opacity: 0.7; }

  .section-head {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 1.25rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-border); flex-wrap: wrap;
    position: relative; z-index: 1;
  }
  .section-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .section-head-text { flex: 1; }
  .section-title { font-size: 0.95rem; font-weight: 600; color: var(--c-text); }
  .section-desc { font-size: 0.72rem; color: var(--c-text-light); margin-top: 0.05rem; }

  /* Input with icon */
  .input-wrap {
    position: relative; display: flex; align-items: stretch;
  }
  .input-icon {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 2.5rem; display: flex; align-items: center; justify-content: center;
    color: var(--c-text-light); opacity: 0.5; pointer-events: none;
    border-right: 1px solid var(--c-glass-border);
    z-index: 2;
  }
  .form-input {
    width: 100%; padding: 0.6rem 0.75rem 0.6rem 3rem; border-radius: 10px;
    border: 1.5px solid var(--c-input-border);
    background: var(--c-input-bg); font-family: var(--font-sans);
    font-size: 0.85rem; color: var(--c-text);
    transition: all 0.2s; outline: none;
  }
  .form-input:focus { border-color: var(--c-primary); box-shadow: 0 0 0 3px var(--c-primary-glow); }
  .aj-textarea { min-height: 72px; resize: vertical; padding-top: 0.6rem; }

  .clinic-form {
    display: flex; gap: 0.75rem; align-items: flex-end;
    position: relative; z-index: 1;
  }
  .clinic-form .input-wrap { flex: 1; }

  .btn-save {
    display: flex; align-items: center; gap: 0.35rem;
    padding: 0.6rem 1.1rem; border-radius: 10px; height: 42px;
    font-size: 0.78rem; font-weight: 600; cursor: pointer;
    font-family: var(--font-sans); border: none;
    background: var(--c-primary); color: white;
    transition: all 0.15s; white-space: nowrap; flex-shrink: 0;
  }
  .btn-save:hover { background: var(--c-primary-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(13,148,136,0.3); }

  .btn-add {
    display: flex; align-items: center; gap: 0.35rem;
    padding: 0.4rem 0.8rem; border-radius: 8px;
    font-size: 0.72rem; font-weight: 600; cursor: pointer;
    font-family: var(--font-sans); border: none;
