  }
  .dash-card:hover .dash-card-glow { opacity: 1; }

  .dash-card-body { position: relative; z-index: 1; padding: 1.25rem; }
  .dash-card-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem; }
  .dash-card-icon-wrap {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .dash-card-label { font-size: 0.78rem; font-weight: 500; color: var(--c-text-light); text-transform: uppercase; letter-spacing: 0.04em; }
