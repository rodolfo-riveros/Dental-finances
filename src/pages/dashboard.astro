  /* Cards */
  .dash-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; animation: fadeUp 0.5s ease both; }
  .dash-cards .dash-card:nth-child(1) { animation-delay: 0.1s; }
