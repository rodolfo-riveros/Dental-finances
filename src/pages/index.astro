---
import LoginForm from '../components/LoginForm.astro';
import RegisterForm from '../components/RegisterForm.astro';
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DentFinance - Gestión Financiera para Clínicas Dentales" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>DentFinance - Iniciar Sesión</title>
  </head>
  <body>
    <button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema">
      <Icon name="sun" class="theme-icon-sun" size={20} />
      <Icon name="moon" class="theme-icon-moon" size={20} />
    </button>

    <div class="auth-page">
      <div class="auth-bg">
        <div class="auth-orb auth-orb-1" />
        <div class="auth-orb auth-orb-2" />
        <div class="auth-orb auth-orb-3" />
      </div>

      <div class="auth-container">
        <div class="auth-brand">
          <div class="auth-brand-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-4 0-6 2-6 5.5 0 3.5.8 7.5 1.8 10 .5 1.2 1.3 3.5 2.7 3.5.5 0 1-.2 1.5-.5L12 21l.6.5c.5.3 1 .5 1.5.5 1.4 0 2.2-2.3 2.7-3.5C17.2 16 18 12 18 8.5 18 5 16 3 12 3z"/><path d="M9 7.5c1-.5 2-1 3-1s2 .5 3 1"/></svg>
          </div>
          <h1 class="auth-brand-title">DentFinance</h1>
          <p class="auth-brand-desc">Gestión financiera para tu clínica dental</p>
        </div>

        <div class="auth-card" id="authCard">
          <div class="auth-tabs">
            <button class="auth-tab active" data-tab="login">Iniciar Sesión</button>
            <button class="auth-tab" data-tab="register">Crear Cuenta</button>
          </div>

          <div class="auth-form" id="authFormLogin">
            <LoginForm />
          </div>
          <div class="auth-form hidden" id="authFormRegister">
            <RegisterForm />
          </div>
        </div>

        <div class="auth-footer">
          Desarrollado por <a href="https://portafolio-rodolfo.vercel.app/" target="_blank" rel="noopener">Rodolfo Riveros Mitma</a> &copy; <span id="footerYear">2026</span>
        </div>
      </div>
    </div>

  </body>
</html>

<script>
  document.getElementById('footerYear').textContent = new Date().getFullYear();

  const tabs = document.querySelectorAll('.auth-tab');
  const loginForm = document.getElementById('authFormLogin');
  const registerForm = document.getElementById('authFormRegister');
  const themeToggle = document.getElementById('themeToggle');

  // Theme
  const stored = localStorage.getItem('df_theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const theme = stored || (prefersDark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', theme);

  themeToggle.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('df_theme', next);
  });

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      if (tab.dataset.tab === 'login') {
        loginForm.classList.remove('hidden');
        registerForm.classList.add('hidden');
      } else {
        loginForm.classList.add('hidden');
        registerForm.classList.remove('hidden');
      }
    });
  });
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --c-primary: #0D9488;
    --c-primary-light: #2DD4BF;
    --c-primary-dark: #0F766E;
    --c-primary-glow: rgba(13, 148, 136, 0.2);
    --c-bg: #F0F2F5;
    --c-glass: rgba(255,255,255,0.7);
    --c-glass-border: rgba(255,255,255,0.5);
    --c-text: #0F172A;
    --c-text-light: #64748B;
    --c-danger: #EF4444;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.04);
    --shadow-lg: 0 10px 25px rgba(0,0,0,0.06), 0 4px 10px rgba(0,0,0,0.04);
    --font-sans: 'Inter', -apple-system, system-ui, sans-serif;
    --c-input-bg: rgba(255,255,255,0.6);
    --c-input-border: #CBD5E1;
    --c-input-placeholder: #94A3B8;
    --c-btn-secondary-bg: rgba(255,255,255,0.5);
    --c-btn-secondary-hover: rgba(255,255,255,0.8);
    --c-social-btn-bg: rgba(255,255,255,0.4);
  }

  [data-theme="dark"] {
    --c-bg: #0F172A;
    --c-glass: rgba(30, 41, 59, 0.85);
    --c-glass-border: rgba(255,255,255,0.06);
    --c-text: #F1F5F9;
    --c-text-light: #94A3B8;
    --c-primary-glow: rgba(13, 148, 136, 0.3);
    --shadow-lg: 0 10px 25px rgba(0,0,0,0.3), 0 4px 10px rgba(0,0,0,0.2);
    --c-input-bg: rgba(30, 41, 59, 0.85);
    --c-input-border: rgba(255,255,255,0.12);
    --c-input-placeholder: #64748B;
    --c-btn-secondary-bg: rgba(255,255,255,0.08);
    --c-btn-secondary-hover: rgba(255,255,255,0.12);
    --c-social-btn-bg: rgba(255,255,255,0.06);

    .form-input {
      background: var(--c-input-bg) !important;
      border-color: var(--c-input-border) !important;
      color: var(--c-text) !important;
    }
    .form-input:focus {
      border-color: var(--c-primary) !important;
      box-shadow: 0 0 0 3px var(--c-primary-glow) !important;
    }
    .form-input.error { border-color: var(--c-danger) !important; }
    .form-input.error:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.25) !important; }
    .form-input::placeholder { color: var(--c-input-placeholder) !important; }
    .checkbox-custom { border-color: var(--c-input-border) !important; }
    .social-btn { background: var(--c-social-btn-bg) !important; border-color: var(--c-input-border) !important; }
  }

  body {
    font-family: var(--font-sans);
    background: var(--c-bg);
    color: var(--c-text);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  .auth-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background:
      radial-gradient(at 0% 0%, rgba(13, 148, 136, 0.04) 0px, transparent 50%),
      radial-gradient(at 100% 100%, rgba(45, 212, 191, 0.04) 0px, transparent 50%);
  }

  .auth-bg {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .auth-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }
  .auth-orb-1 {
    top: -80px; right: -60px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(13,148,136,0.08), transparent);
    animation: orbFloat 8s ease-in-out infinite;
  }
  .auth-orb-2 {
    bottom: -60px; left: -60px;
    width: 250px; height: 250px;
    background: radial-gradient(circle, rgba(45,212,191,0.06), transparent);
    animation: orbFloat 10s ease-in-out infinite 2s;
  }
  .auth-orb-3 {
    top: 40%; left: 50%;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(13,148,136,0.04), transparent);
    animation: orbFloat 7s ease-in-out infinite 4s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.1); }
  }

  .auth-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
  }

  .auth-brand {
    text-align: center;
    margin-bottom: 2rem;
  }
  .auth-brand-icon {
    width: 56px; height: 56px;
    margin: 0 auto 1rem;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--c-primary), var(--c-primary-light));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 8px 24px rgba(13,148,136,0.3);
  }
  .auth-brand-icon svg { width: 30px; height: 30px; }
  .auth-brand-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }
  .auth-brand-desc {
    font-size: 0.875rem;
    color: var(--c-text-light);
  }

  .auth-card {
    background: var(--c-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--c-glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.5rem;
  }

  .auth-tabs {
    display: flex;
    background: rgba(0,0,0,0.03);
    border-radius: 10px;
    padding: 0.2rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--c-glass-border);
  }
  .auth-tab {
    flex: 1;
    padding: 0.5rem 1rem;
    border: none;
    background: none;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-text-light);
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s;
  }
  .auth-tab.active {
    background: white;
    color: var(--c-primary);
    box-shadow: var(--shadow-sm);
  }
  .auth-tab:not(.active):hover { color: var(--c-text); }

  .auth-form { animation: fadeIn 0.25s ease-out; }
  .auth-form.hidden { display: none; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  *:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 100;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--c-glass);
    backdrop-filter: blur(12px);
    border: 1px solid var(--c-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--c-text);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s;
  }
  .theme-toggle:hover {
    box-shadow: var(--shadow-md);
    transform: scale(1.05);
  }
  .theme-toggle .theme-icon-sun { display: none; }
  .theme-toggle .theme-icon-moon { display: block; }
  [data-theme="dark"] .theme-toggle .theme-icon-sun { display: block; }
  [data-theme="dark"] .theme-toggle .theme-icon-moon { display: none; }

  .auth-footer {
    text-align: center;
    font-size: 0.8rem;
    color: var(--c-text-light);
    padding: 1.5rem 0 0;
  }
  .auth-footer a {
    color: var(--c-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .auth-footer a:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
