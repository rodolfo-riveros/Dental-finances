---
import Layout from '../layouts/Layout.astro';
import ExpenseForm from '../components/ExpenseForm.astro';
import Icon from '../components/Icon.astro';
const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const today = new Date();
const currentMonth = today.getMonth();
---

<Layout title="Registro de Gastos - DentFinance">
  <div class="page">
    <header class="page-header">
      <div>
        <h1 class="page-title">Registro de Gastos</h1>
        <p class="page-subtitle">Gestiona y registra tus gastos operativos</p>
      </div>
      <div class="page-header-stats">
        <div class="stat-chip">
          <span class="stat-chip-label">Hoy</span>
          <span class="stat-chip-value" id="statHoy">S/ 0</span>
        </div>
        <div class="stat-chip">
          <span class="stat-chip-label">Este mes</span>
          <span class="stat-chip-value" id="totalMes">S/ 0</span>
        </div>
        <div class="stat-chip">
          <span class="stat-chip-label">Registros</span>
          <span class="stat-chip-value" id="countRegistros">0</span>
        </div>
      </div>
    </header>

    <div class="gastos-layout">
      <div class="glass-card form-section">
        <div class="section-head">
          <div class="section-head-icon">
            <Icon name="plus" size={20} />
          </div>
          <div>
            <h2 class="section-title">Nuevo Gasto</h2>
            <p class="section-desc">Completa los campos para registrar un gasto</p>
          </div>
        </div>
        <ExpenseForm />
      </div>

      <div class="glass-card history-section">
        <div class="section-head">
          <div class="section-head-icon" style="background: rgba(99,102,241,0.1); color: #6366F1;">
            <Icon name="clipboard-list" size={20} />
          </div>
          <div class="section-head-text">
            <h2 class="section-title">Historial de Gastos</h2>
            <p class="section-desc" id="historialDesc">Mostrando gastos de hoy</p>
          </div>
          <select class="month-filter" id="gastosMonthFilter">
            <option value="-1">Mostrar hoy</option>
            {months.map((m, i) => (
              <option value={i} selected={i === currentMonth}>{m}</option>
            ))}
            <option value="99">Ver todos</option>
          </select>
          <button class="pdf-btn" id="exportPdfBtn" title="Exportar PDF del mes">
            <Icon name="file-text" size={16} />
            PDF
          </button>
        </div>

        <div class="expenses-list" id="expensesList"></div>
        <div class="expenses-empty hidden" id="expensesEmpty">
          <Icon name="receipt" size={24} />
          <span>No hay gastos registrados hoy</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal detalle -->
  <div class="dtl-overlay hidden" id="detailModal">
    <div class="dtl-panel">
      <div class="dtl-head">
        <div class="dtl-head-left">
          <div class="dtl-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <div class="dtl-title">Detalle del Gasto</div>
            <span class="dtl-badge" id="mCat">Categoría</span>
          </div>
        </div>
        <button class="dtl-close" id="modalClose">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="dtl-body">
        <div class="dtl-amount-row">
          <span class="dtl-amount" id="mAmount">S/ 0</span>
          <span class="dtl-date" id="mDate">—</span>
        </div>

        <div class="dtl-desc-box">
          <span class="dtl-desc-label">Descripción</span>
          <p class="dtl-desc" id="mDesc">—</p>
        </div>

        <div class="dtl-voucher-box" id="mVoucherField" style="display:none">
          <div class="dtl-voucher-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
            <span>Comprobante</span>
          </div>
          <div class="dtl-voucher-img-wrap">
            <img id="mVoucherImg" class="dtl-voucher-img" alt="Comprobante" />
            <span id="voucherError" class="dtl-voucher-err">No se pudo cargar la imagen</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Print area (hidden on screen) -->
  <div id="printArea" class="print-area"></div>
</Layout>

<script>
  import { fetchExpenses, addExpense, updateExpense, deleteExpenseWithVoucher, uploadVoucher, getVoucherPreview } from '../lib/data';

  const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  let expensesData = [];
  let currentFilter = -1;
  let editingId = null;
  let gastosPage = 1;
  const PER_PAGE = 10;

  function parseDate(dateStr) {
    const parts = dateStr.split('-');
    if (parts.length === 3) {
      const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
      if (!isNaN(y) && !isNaN(m) && !isNaN(d)) return { day: d, month: m };
    }
    const dt = new Date(dateStr);
    if (!isNaN(dt.getTime())) return { day: dt.getDate(), month: dt.getMonth() };
    const sp = dateStr.split(' ');
    const sd = parseInt(sp[0]);
    const map = { 'ene':0,'feb':1,'mar':2,'abr':3,'may':4,'jun':5,'jul':6,'ago':7,'sep':8,'oct':9,'nov':10,'dic':11 };
    return { day: sd, month: map[(sp[1]||'').toLowerCase().slice(0,3)] ?? 0 };
  }

  function formatDate(dateStr) {
    const { day, month } = parseDate(dateStr);
    return String(day).padStart(2,'0') + ' ' + months[month].slice(0,3);
  }

  const expensesList = document.getElementById('expensesList');
  const emptyMsg = document.getElementById('expensesEmpty');
  const statHoy = document.getElementById('statHoy');
  const totalMesEl = document.getElementById('totalMes');
  const historialDesc = document.getElementById('historialDesc');
  const monthFilter = document.getElementById('gastosMonthFilter');
  const countRegsEl = document.getElementById('countRegistros');
  const modal = document.getElementById('detailModal');
  const modalClose = document.getElementById('modalClose');
  const mDesc = document.getElementById('mDesc');
  const mCat = document.getElementById('mCat');
  const mAmount = document.getElementById('mAmount');
  const mDate = document.getElementById('mDate');
  const mVoucherField = document.getElementById('mVoucherField');
  const mVoucherImg = document.getElementById('mVoucherImg');
  const exportBtn = document.getElementById('exportPdfBtn');

  function renderExpenses(filter) {
    const now = new Date();
    const filtered = expensesData.filter(e => {
      const { day, month } = parseDate(e.date);
      if (filter === -1) return day === now.getDate() && month === now.getMonth();
      if (filter === 99) return true;
      return month === filter;
    });

    const hoyTotal = expensesData.filter(e => {
      const { day, month } = parseDate(e.date);
      return day === now.getDate() && month === now.getMonth();
    }).reduce((s, e) => s + e.amount, 0);
    const mesTotal = expensesData.reduce((s, e) => {
      const { month } = parseDate(e.date);
      return month === now.getMonth() ? s + e.amount : s;
    }, 0);

    if (filtered.length === 0) {
      expensesList.innerHTML = '';
      expensesList.classList.add('hidden');
      emptyMsg.classList.remove('hidden');
      const label = filter === -1 ? 'hoy' : filter === 99 ? 'todos los registros' : months[filter];
      historialDesc.textContent = `Sin gastos — ${label}`;
      statHoy.textContent = 'S/ ' + hoyTotal.toLocaleString();
      totalMesEl.textContent = 'S/ ' + mesTotal.toLocaleString();
      countRegsEl.textContent = expensesData.length;
      return;
    }

    expensesList.classList.remove('hidden');
    emptyMsg.classList.add('hidden');

    const total = filtered.reduce((s, e) => s + e.amount, 0);
    statHoy.textContent = 'S/ ' + hoyTotal.toLocaleString();
    totalMesEl.textContent = 'S/ ' + mesTotal.toLocaleString();
    countRegsEl.textContent = expensesData.length;

    const label = filter === -1 ? 'Hoy' : filter === 99 ? 'Todos' : months[filter];
    historialDesc.textContent = label + ' — ' + filtered.length + ' gastos · S/ ' + total.toLocaleString();

    const totalPages = Math.ceil(filtered.length / PER_PAGE);
    if (gastosPage > totalPages) gastosPage = totalPages;
    const start = (gastosPage - 1) * PER_PAGE;
    const pageItems = filtered.slice(start, start + PER_PAGE);

    expensesList.innerHTML = pageItems.map((expense, i) => {
      const formatted = formatDate(expense.date);
      return `
        <div class="expense-card" data-id="${escHtml(String(expense.id))}" style="animation-delay: ${i * 0.04}s">
          <div class="expense-card-main">
            <div class="expense-left">
              <div class="expense-icon" style="background: rgba(239,68,68,0.1); color: #DC2626;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div class="expense-info">
                <span class="expense-desc">${escHtml(expense.description)}</span>
                <div class="expense-meta">
                  <span class="expense-cat">${escHtml(expense.category)}</span>
                  <span class="expense-sep">•</span>
                  <span class="expense-date">${formatted}</span>
                </div>
              </div>
            </div>
            <div class="expense-right">
              <span class="expense-amount">-S/ ${expense.amount.toLocaleString()}</span>
              <div class="expense-actions">
                <button class="expense-action-btn expense-edit-btn" aria-label="Editar" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                </button>
                <button class="expense-action-btn expense-delete-btn" aria-label="Eliminar" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
    }).join('');

    if (totalPages > 1) {
      let pagHtml = '<div class="pagination">';
      if (gastosPage > 1) pagHtml += `<button class="pag-btn" data-page="${gastosPage - 1}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg> Anterior</button>`;
      for (let p = 1; p <= totalPages; p++) {
        const active = p === gastosPage ? ' active' : '';
        pagHtml += `<button class="pag-btn${active}" data-page="${p}">${p}</button>`;
      }
      if (gastosPage < totalPages) pagHtml += `<button class="pag-btn" data-page="${gastosPage + 1}">Siguiente <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></button>`;
      pagHtml += '</div>';
      expensesList.insertAdjacentHTML('beforeend', pagHtml);
    }
  }

  function escHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  monthFilter.addEventListener('change', function() {
    currentFilter = parseInt(this.value);
    gastosPage = 1;
    renderExpenses(currentFilter);
  });

  async function handleDelete(id) {
    const expense = expensesData.find(ex => String(ex.id) === String(id));
    if (!expense) return;
    const ok = await window.showConfirm('¿Eliminar este gasto?');
    if (!ok) return;
    try {
      await deleteExpenseWithVoucher(id, expense.voucher);
      expensesData = expensesData.filter(ex => String(ex.id) !== String(id));
      renderExpenses(currentFilter);
      window.showToast('Gasto eliminado.', 'success');
    } catch (err) {
      console.error('Error deleting expense:', err);
      window.showToast('Error al eliminar el gasto.', 'error');
    }
  }

  expensesList.addEventListener('click', async function(e) {
    const pagBtn = e.target.closest('.pag-btn');
    if (pagBtn) {
      gastosPage = parseInt(pagBtn.dataset.page);
      renderExpenses(currentFilter);
      return;
    }
    const editBtn = e.target.closest('.expense-edit-btn');
    if (editBtn) {
      const card = editBtn.closest('.expense-card');
      if (!card) return;
      const expense = expensesData.find(ex => String(ex.id) === card.dataset.id);
      if (!expense) return;
      editingId = expense.id;
      const event = new CustomEvent('fill-expense-form', {
        detail: { id: expense.id, description: expense.description, category: expense.category, amount: expense.amount, date: expense.date, voucher: expense.voucher }
      });
      document.dispatchEvent(event);
      return;
    }
    const deleteBtn = e.target.closest('.expense-delete-btn');
    if (deleteBtn) {
      const card = deleteBtn.closest('.expense-card');
      if (card) handleDelete(card.dataset.id);
      return;
    }
    const card = e.target.closest('.expense-card');
    if (card) await openModal(card.dataset.id);
  });

  async function openModal(id) {
    const expense = expensesData.find(e => String(e.id) === String(id));
    if (!expense) return;
    mDesc.textContent = expense.description;
    mCat.textContent = expense.category;
    mAmount.textContent = 'S/ ' + expense.amount.toLocaleString();
    const { day, month } = parseDate(expense.date);
    mDate.textContent = String(day).padStart(2,'0') + ' de ' + months[month];
    if (expense.voucher && mVoucherField && mVoucherImg) {
      mVoucherField.style.display = '';
      const errEl = document.getElementById('voucherError');
      try {
        const url = getVoucherPreview(expense.voucher);
        const resp = await fetch(url);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const blob = await resp.blob();
        mVoucherImg.src = URL.createObjectURL(blob);
        mVoucherImg.style.display = '';
        if (errEl) errEl.style.display = 'none';
      } catch (err) {
        console.warn('Failed to load voucher image:', err);
        mVoucherImg.style.display = 'none';
        if (errEl) errEl.style.display = '';
      }
    } else if (mVoucherField) {
      mVoucherField.style.display = 'none';
    }
    modal.classList.remove('hidden');
    modal.classList.add('visible');
  }

  function closeModal() {
    modal.classList.remove('visible');
    modal.classList.add('hidden');
  }

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  exportBtn.addEventListener('click', async function() {
    const now = new Date();
    const filter = currentFilter === -1 ? now.getMonth() : currentFilter === 99 ? -1 : currentFilter;
    const filtered = filter === -1
      ? [...expensesData]
      : expensesData.filter(e => {
          const { month } = parseDate(e.date);
          return month === filter;
        });
    if (filtered.length === 0) {
      window.showToast('No hay gastos para exportar.', 'info');
      return;
    }
    const label = filter === -1 ? 'Todos los meses' : months[filter];
    const total = filtered.reduce((s, e) => s + e.amount, 0);

    const rows = await Promise.all(filtered.map(async (e) => {
      const { day, month } = parseDate(e.date);
      const dateStr = String(day).padStart(2,'0') + ' ' + months[month];
      let imgHtml = '';
      if (e.voucher) {
        try {
          const url = getVoucherPreview(e.voucher);
          const resp = await fetch(url);
          if (resp.ok) {
            const blob = await resp.blob();
            const dataUrl = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onloadend = () => resolve(reader.result);
              reader.readAsDataURL(blob);
            });
            imgHtml = `<img src="${dataUrl}" class="print-voucher" />`;
          }
        } catch (_) {}
      }
      return `<tr><td>${dateStr}</td><td>${escHtml(e.category)}</td><td>${escHtml(e.description)}</td><td style="text-align:right">S/ ${e.amount.toLocaleString('es-PE')}</td><td>${imgHtml}</td></tr>`;
    }));
    const rowsHtml = rows.join('');

    const printArea = document.getElementById('printArea');
    printArea.innerHTML = `
      <div class="print-header">
        <div class="print-brand">
          <svg class="print-logo" viewBox="0 0 128 128" width="36" height="36"><rect width="128" height="128" rx="28" fill="#0D9488"/><path d="M64 28c-21 0-32 11-32 30 0 19 4 40 10 54 2 6 5 16 11 16 3 0 6-2 9-4l2-2 2 2c3 2 6 4 9 4 6 0 9-10 11-16 6-14 10-35 10-54 0-19-11-30-32-30z" fill="#fff"/><path d="M50 44c5-4 10-6 14-6s9 2 14 6" fill="none" stroke="#0D9488" stroke-width="4" stroke-linecap="round"/></svg>
          <div>
            <div class="print-brand-name">DentFinance</div>
            <div class="print-brand-tag">Sistema de Gestión Dental</div>
          </div>
        </div>
        <div class="print-title-block">
          <h1 class="print-title">Reporte de Gastos</h1>
          <p class="print-period">${label} · ${now.getFullYear()}</p>
        </div>
        <div class="print-meta">
          <span>Generado: ${now.toLocaleDateString('es-PE', { year:'numeric', month:'long', day:'numeric' })}</span>
          <span>${now.toLocaleTimeString('es-PE', { hour:'2-digit', minute:'2-digit' })}</span>
        </div>
      </div>
      <div class="print-summary">
        <div class="print-summary-item">
          <span class="print-summary-label">Total Gastos</span>
          <span class="print-summary-value">S/ ${total.toLocaleString('es-PE')}</span>
        </div>
        <div class="print-summary-item">
          <span class="print-summary-label">Cantidad</span>
          <span class="print-summary-value">${filtered.length} registros</span>
        </div>
        <div class="print-summary-item">
          <span class="print-summary-label">Periodo</span>
          <span class="print-summary-value">${label}</span>
        </div>
      </div>
      <table class="print-table">
        <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Monto</th><th>Comprobante</th></tr></thead>
        <tbody>${rowsHtml}</tbody>
        <tfoot><tr><td colspan="3" style="text-align:right;font-weight:700;font-size:0.85rem">Total</td><td style="text-align:right;font-weight:700;font-size:0.85rem">S/ ${total.toLocaleString('es-PE')}</td><td></td></tr></tfoot>
      </table>
      <div class="print-footer">
        <p>DentFinance © ${now.getFullYear()} — Reporte generado automáticamente</p>
      </div>
    `;
    printArea.classList.add('print-active');
    window.print();
    setTimeout(() => {
      printArea.classList.remove('print-active');
      printArea.innerHTML = '';
    }, 1000);
  });

  document.addEventListener('new-expense', async function(e) {
    const expense = e.detail;
    try {
      let voucher = '';
      if (expense.file) {
        try {
          voucher = await uploadVoucher(expense.file);
        } catch (err) {
          console.warn('Error uploading voucher, expense will be saved without image:', err);
        }
      }
      const created = await addExpense({
        description: expense.description,
        category: expense.category,
        amount: expense.amount,
        date: expense.date,
        voucher
      });
      expense.id = created.$id;
      expense.date = expense.date || new Date().toISOString().split('T')[0];
      expense.voucher = voucher;
      expensesData.unshift({ ...expense });
      renderExpenses(currentFilter);
      window.showToast('Gasto registrado correctamente.', 'success');
    } catch (err) {
      console.error('Error saving expense to Appwrite:', err);
      window.showToast('Error al guardar el gasto.', 'error');
    }
  });

  document.addEventListener('update-expense', async function(e) {
    const expense = e.detail;
    try {
      const updateData = {
        description: expense.description,
        category: expense.category,
        amount: expense.amount,
        date: expense.date,
      };
      let voucher = expense.voucher || '';
      if (expense.file) {
        try {
          voucher = await uploadVoucher(expense.file);
          updateData.voucher = voucher;
        } catch (err) {
          console.warn('Error uploading voucher:', err);
        }
      }
      await updateExpense(expense.id, updateData);
      const idx = expensesData.findIndex(ex => String(ex.id) === String(expense.id));
      if (idx >= 0) {
        expensesData[idx] = { ...expensesData[idx], ...updateData, voucher };
      }
      editingId = null;
      renderExpenses(currentFilter);
      window.showToast('Gasto actualizado.', 'success');
    } catch (err) {
      console.error('Error updating expense:', err);
      window.showToast('Error al actualizar el gasto.', 'error');
    }
  });

  document.addEventListener('cancel-edit', function() {
    editingId = null;
  });

  async function init() {
    try {
      const docs = await fetchExpenses();
      expensesData = docs.map(d => ({
        id: d.$id,
        description: d.description || '',
        category: d.category || '',
        amount: Number(d.amount) || 0,
        date: d.date || d.$createdAt,
        voucher: d.voucher || ''
      }));
    } catch (err) {
      console.warn('No se pudieron cargar los gastos desde Appwrite:', err);
    }
    renderExpenses(-1);
  }

  init();
</script>

